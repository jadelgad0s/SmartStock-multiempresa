# Plantilla sin secretos para las variables del NUEVO servicio multiempresa.
DJANGO_SETTINGS_MODULE=esquema_multiempresa.production
SS_DOMINIO_EMPRESAS=smartstockchile.cl
SECRET_KEY=
# Tres URLs DIRECTAS de Neon con sslmode=require (sin -pooler).
SS_CENTRAL_DATABASE_URL=
SS_FERRETERIA_DATABASE_URL=
SS_REPUESTOS_DATABASE_URL=
# Bucket privado compatible con S3; se prepara por separado de Render.
SS_S3_ENDPOINT_URL=
SS_S3_BUCKET=
SS_S3_ACCESS_KEY_ID=
SS_S3_SECRET_ACCESS_KEY=
SS_S3_REGION=us-east-2
# Proveedor HTTPS para recuperación e invitaciones.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=SmartStock <no-reply@smartstockchile.cl>
SMS_ALERTAS_ACTIVAS=False
SS_HSTS_SECONDS=0
# Solo para verificar conexiones y archivos durante un despliegue temporal.
SS_VERIFICAR_PRODUCCION=False
